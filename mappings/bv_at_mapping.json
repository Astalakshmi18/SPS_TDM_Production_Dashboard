{
  "project_key": "BV_AT",
  "display_name": "Belgium Vitals",
  "branch": "TDM",
  "config": {
    "project_name": {
      "mode": "cell",
      "sheet": "Version Control",
      "cell": "B1"
    },
    "branch": {
      "mode": "static",
      "value": "TDM"
    },
    "start_date": {
      "mode": "cell",
      "sheet": "Project Summary",
      "cell": "D1"
    },
    "end_date": {
      "mode": "cell",
      "sheet": "Project Summary",
      "cell": "F1"
    },
    "target": {
      "mode": "cell",
      "sheet": "Project Summary",
      "cell": "B2"
    },
    "delivered": {
      "mode": "cell",
      "sheet": "Project Summary",
      "cell": "B4"
    },
    "images": {
      "mode": "sum_column",
      "sheet": "Calculation",
      "column": "Total Image"
    },
    "total_batches": {
      "mode": "sum_multi",
      "sources": [
        {"mode": "row_count", "sheet": "BV_Inventory_01"},
        {"mode": "row_count", "sheet": "BV_Inventory_02"}
      ]
    },
    "promoted": {
      "mode": "sum_multi",
      "sources": [
        {"mode": "row_count", "sheet": "BV_Inventory_01", "where_column": "Shipment"},
        {"mode": "row_count", "sheet": "BV_Inventory_02", "where_column": "Shipment"}
      ]
    },
    "batches_being_keyed": {
      "mode": "sum_multi",
      "sources": [
        {"mode": "row_count", "sheet": "BV_Inventory_01", "where_column_blank": "Shipment"},
        {"mode": "row_count", "sheet": "BV_Inventory_02", "where_column_blank": "Shipment"}
      ]
    },
    "extra_fields": {
      "Volume Unit": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "C2"
      },
      "Days Gone": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "C4"
      },
      "Delivered % (as reported)": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "B5"
      },
      "Days Gone %": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "B6"
      },
      "Remaining Records (as reported)": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "B8"
      },
      "Remaining Days (as reported)": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "C8"
      },
      "Total Duration (Days)": {
        "mode": "cell",
        "sheet": "Project Summary",
        "cell": "H1"
      }
    },
    "inventory_rows": {
      "sheet": "Calculation",
      "columns": {
        "folder_name": "Main Folder Name",
        "event_type": "Event Type",
        "image_count": "Total Image",
        "record_count": "Total Rec.",
        "shipment_date": "Shipment Date"
      }
    }
  }
}